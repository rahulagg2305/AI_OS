# Base URL the generated API client (src/api/client.ts) sends requests
# to. Empty/unset resolves to same-origin relative requests — correct
# when this dashboard is served behind the same gateway as the Kernel
# API (ADR-0018's own documented deployment shape). Set explicitly for
# local development against a Kernel running on a different origin.
VITE_API_BASE_URL=http://localhost:8000
