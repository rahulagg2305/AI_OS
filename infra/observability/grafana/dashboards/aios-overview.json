{
  "title": "AI_OS Overview",
  "uid": "aios-overview",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "aios.http.requests (real Kernel counter, via OTLP -> Collector -> Prometheus)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate({__name__=~\"aios_http_requests.*\"}[1m])) by (http_status_code, http_method)",
          "legendFormat": "{{http_method}} {{http_status_code}}",
          "refId": "A"
        }
      ]
    }
  ]
}
