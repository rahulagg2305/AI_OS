  "info": {
    "description": "Transport layer for the AI_OS Platform Kernel. No business logic lives here \u2014 see docs/07_api/api_architecture.md.",
    "title": "AI_OS Kernel API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "description": "Liveness probe. Must never depend on an external service \u2014 a brief\ndependency blip must not cause a container restart (Deployment\nArchitecture \u00a76).",
        "operationId": "health_live_api_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Live Api V1 Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Live",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Readiness probe. Returns HTTP 200 for \"ready\"/\"degraded\" \u2014 a\nreduced-capability Kernel can still usefully serve some traffic \u2014\nand HTTP 503 for \"not_ready\": at least one critical component (the\ndatabase, today \u2014 see ``ai_os_kernel.health.service``'s own\ndocstring for why it is a real hard dependency, not an assumed one)\nhas failed, and every functional route in this codebase already\nindependently 503s without one anyway.",
        "operationId": "health_ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/packs": {
      "post": {
        "operationId": "register_pack_api_v1_packs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterPackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Register Pack",
        "tags": [
          "packs"
        ]
      }
    },
    "/api/v1/packs/{pack_id}": {
      "get": {
        "operationId": "get_pack_api_v1_packs__pack_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "pack_id",
            "required": true,
            "schema": {
              "title": "Pack Id",
              "type": "string"
